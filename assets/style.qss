/* Voice Changer Dark Theme */

QMainWindow {
    background-color: #2b2b2b;
}

QWidget {
    background-color: #2b2b2b;
    color: #eeeeee;
    font-family: "Noto Sans CJK SC", "WenQuanYi Micro Hei", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
}

QGroupBox {
    border: 1px solid #555555;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #00c896;
}

QPushButton {
    background-color: #3d3d3d;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 12px;
    color: #eeeeee;
}

QPushButton:hover {
    background-color: #4d4d4d;
    border-color: #00c896;
}

QPushButton:pressed {
    background-color: #00c896;
    color: #1a1a1a;
}

QPushButton:checked {
    background-color: #00c896;
    color: #1a1a1a;
    border-color: #00c896;
}

QComboBox {
    background-color: #3d3d3d;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #eeeeee;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #3d3d3d;
    border: 1px solid #555555;
    color: #eeeeee;
    selection-background-color: #00c896;
    selection-color: #1a1a1a;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #555555;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00c896;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #00c896;
    border-radius: 3px;
}

QLabel {
    color: #cccccc;
}

QStatusBar {
    background-color: #1f1f1f;
    color: #aaaaaa;
}

QMessageBox {
    background-color: #2b2b2b;
}

QMessageBox QPushButton {
    min-width: 60px;
}
